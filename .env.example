# ==========================================
# Core LLM API Configuration
# ==========================================
# Choose your reasoning LLM: GROQ, OPENAI, or DEEPSEEK
Agent_llm=GROQ

# Groq API Key (Free, recommended for fast tool calling)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# DeepSeek API Key (Optional)
DEEPSEEK_API_KEY=

# ==========================================
# Embeddings & Vector DB (RAG)
# ==========================================
# Pinecone API Key for Standard Operating Procedures (SOP) vector index
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Embedding mode: LOCAL (Free via Transformers.js), OLLAMA, or OPENAI
Emdeddings_model=LOCAL
Local_Embeddings_Model=Xenova/bge-large-en-v1.5
PINECONE_INDEX_NAME=fde-sop-index-local

# ==========================================
# MSSQL Fleet Telemetry Database
# ==========================================
SQL_SERVER_HOST=3.110.207.231
SQL_SERVER_PORT=1433
SQL_DATABASE=master

# Read-only user for agent queries
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=AgentPassword2026!

# High-privilege administrator for audit logs inspection
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=FdeEnterprisePass123!

# ==========================================
# Server Configuration
# ==========================================
PORT=5001
VITE_API_URL=http://localhost:5001
